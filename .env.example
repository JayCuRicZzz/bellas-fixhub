# ============================================
# Bellas FixHub v2 — Environment Variables
# Copy to .env.local (dev) or set in Vercel → Project → Settings → Environment Variables
# ============================================

# --- Supabase (REQUIRED) — project "bella-hr", schema "fixhub" ---
NEXT_PUBLIC_SUPABASE_URL=https://kiguywlubwxdhvpkexcl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: Supabase Dashboard → Project Settings → API Keys → service_role (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string: Dashboard → Connect → "Transaction pooler" (port 6543)
# postgresql://postgres.kiguywlubwxdhvpkexcl:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=ticket-images

# --- Security (REQUIRED) — CRON_SECRET is also what Vercel Cron sends as Bearer token ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_KEY=
CRON_SECRET=

# --- LINE Messaging API (optional; can also be set from /dashboard/admin/line-settings) ---
LINE_ACCESS_TOKEN=
LINE_TARGET_ID_MAINT=
LINE_TARGET_ID_IT=

# --- AI (Groq free tier) — leave blank to use rule-based fallback ---
AI_PROVIDER=groq
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# --- App URL ---
NEXT_PUBLIC_APP_URL=https://bellafixhub.bellavillapattaya.com
